# ─── Voice Compliance Agent — environment ─────────────────────────────────────
# Copy this file to `.env` for local development.

# DATABASE — pick ONE mode:

# 1) LOCAL DEV (default — SQLite, zero setup, file lands in ./db/)
DATABASE_URL="file:../db/custom.db"

# 2) PRODUCTION / VERCEL — hosted Postgres (Neon, Vercel Postgres, Supabase…)
#    Use the POOLED connection string and append the serverless-safe params:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true&connection_limit=1"

# ─── Optional: Z.AI credentials ───────────────────────────────────────────────
# Without them the app still runs end-to-end: the listening/thesis agents fall
# back to deterministic heuristics and the Voice Executor speaks through the
# browser's built-in speech synthesis.
# ZAI_API_KEY=""

# ─── Optional: AssemblyAI (voice intake) ──────────────────────────────────────
# Enables live speech-to-text + sentiment analysis for the "Voice Intake"
# panel in the Live Call tab (record the customer, or play a bundled sample).
# Free key: https://dashboard.assemblyai.com/
# Without it the app runs in DEMO mode: bundled samples replay pre-computed
# transcripts so the flow stays fully demonstrable.
# ASSEMBLYAI_API_KEY=""
